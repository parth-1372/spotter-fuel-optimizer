# Environment variables template — copy this to .env and fill in values
# DO NOT commit .env to version control

# OpenRouteService API key — get a free key at https://openrouteservice.org/
ORS_API_KEY=your-openrouteservice-api-key-here

# Django settings
DJANGO_SECRET_KEY=replace-this-with-a-strong-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
